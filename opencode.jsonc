{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "bash": {
      "*": "ask",

      "git status": "allow",
      "git status *": "allow",

      "git diff": "allow",
      "git diff *": "allow",

      "git log": "allow",
      "git log *": "allow",

      "python3 -m compileall *": "allow",

      "pdftotext docs/IA_2026_P1.pdf -": "allow",
      "pdfinfo docs/IA_2026_P1.pdf": "allow",
      "pdfinfo docs/IA_2026_P1.pdf *": "allow",

      "git add": "ask",
      "git add *": "ask",

      "git commit": "deny",
      "git commit *": "deny",

      "git push": "deny",
      "git push *": "deny",

      "git reset --hard": "deny",
      "git reset --hard *": "deny",

      "git clean": "deny",
      "git clean *": "deny",

      "rm -rf *": "deny"
    }
  }
}
